          "openai/fcm"
        ],
        "env": {
          "OPENAI_API_BASE": "{BASE}",
          "OPENAI_API_KEY": "fcm-local-no-key",
          "MSWEA_COST_TRACKING": "ignore_errors"
        },
        "verifyPy": {
          "python": "%APPDATA%\\uv\\tools\\mini-swe-agent\\Scripts\\python.exe",
          "code": "import os,litellm; r=litellm.completion(model='openai/fcm',messages=[{'role':'user','content':'Reply only with the word OK'}],api_base=os.environ['OPENAI_API_BASE'],api_key=os.environ['OPENAI_API_KEY'],max_tokens=16,timeout=45); print(r.choices[0].message.content)",
          "label": "model path via mini's own litellm (TUI needs a console: INTERACTIVE_REQUIRED)"
        }
      },
      "fcmDefault": true
    },
