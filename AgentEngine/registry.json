{
  "$comment": "X Agent CLI registry. cmd: candidates tried in order via where.exe. tier: free-fcm | free-tier | paid | byok | mixed | unknown (cost label; never 'free' without evidence). loginCmd: OFFICIAL interactive login (user completes it in the browser). install: OFFICIAL method only. hidden: kept for history, not shown in the active UI.",
  "agents": [
    {
      "id": "opencode",
      "name": "OpenCode",
      "host": { "resumeArgs": ["--session", "{SESSION}"] },
      "cmd": [
        "opencode"
      ],
      "versionArgs": [
        "--version"
      ],
      "auth": "own config (opencode auth.json)",
      "tier": "mixed",
      "tierNote": "free via FCM; your other providers may be paid",
      "usage": "opencode stats (local statistics)",
      "mcpList": "opencode mcp list",
      "site": "https://opencode.ai",
      "install": null
    },
    {
      "id": "claude",
      "name": "Claude Code",
      "host": {
        "profileMode": "claude-config",
        "loginArgs": ["auth", "login"],
        "createSessionArgs": ["--session-id", "{SESSION}"],
        "resumeArgs": ["--resume", "{SESSION}"],
        "addDirFlag": "--add-dir",
        "authEnv": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY"],
        "profileNote": "Official CLAUDE_CONFIG_DIR for claude.ai accounts; Console login without API key is not independently isolated",
        "docs": "https://code.claude.com/docs/en/cli-usage"
      },
      "cmd": [
        "claude"
      ],
      "versionArgs": [
        "--version"
      ],
      "auth": "Anthropic OAuth (claude.ai)",
      "tier": "paid",
      "tierNote": "subscription",
      "usage": "/usage inside Claude Code",
      "mcpList": "claude mcp list",
      "loginCmd": "claude",
      "site": "https://claude.com/claude-code",
      "install": null,
      "verifyCmd": "claude -p \"Reply only with the word OK\" --no-session-persistence",
      "verifyTimeout": 90
    },
