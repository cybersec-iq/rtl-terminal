    {
      "id": "mini",
      "name": "mini-SWE-agent",
      "cmd": [
        "mini",
        "mini-swe-agent"
      ],
      "versionArgs": [
        "--version"
      ],
      "auth": "BYOK env (litellm)",
      "tier": "byok",
      "site": "https://github.com/SWE-agent/mini-swe-agent",
