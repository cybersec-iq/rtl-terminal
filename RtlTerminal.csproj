<Project Sdk="Microsoft.NET.Sdk">



  <PropertyGroup>

    <OutputType>WinExe</OutputType>

    <TargetFramework>net8.0-windows</TargetFramework>

    <AssemblyName>RtlTerminal</AssemblyName>

    <RootNamespace>RtlTerminal</RootNamespace>

    <ApplicationIcon>RtlTerminal.ico</ApplicationIcon>

    <Company>AryanIQ</Company>

    <Authors>AryanIQ</Authors>

    <Product>Rtl Terminal</Product>

    <Description>AryanIQ terminal with approved dark-blue Windows Terminal theme and Persian/RTL support.</Description>

    <Version>1.1.15</Version>

    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <UseWPF>true</UseWPF>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

  </PropertyGroup>

  <ItemGroup>
    <Content Include="AgentEngine\**\*" Link="AgentEngine\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.25.260930003" GeneratePathProperty="true" ExcludeAssets="build;runtime;native" />
    <Content Include="$(PkgMicrosoft_Windows_Console_ConPTY)/runtimes/win-x64/native/conpty.dll" Link="ConPty/x64/conpty.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="$(PkgMicrosoft_Windows_Console_ConPTY)/build/native/runtimes/x64/OpenConsole.exe" Link="ConPty/x64/OpenConsole.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="$(PkgMicrosoft_Windows_Console_ConPTY)/runtimes/win-x86/native/conpty.dll" Link="ConPty/x86/conpty.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="$(PkgMicrosoft_Windows_Console_ConPTY)/build/native/runtimes/x86/OpenConsole.exe" Link="ConPty/x86/OpenConsole.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="$(PkgMicrosoft_Windows_Console_ConPTY)/runtimes/win-arm64/native/conpty.dll" Link="ConPty/arm64/conpty.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="$(PkgMicrosoft_Windows_Console_ConPTY)/build/native/runtimes/arm64/OpenConsole.exe" Link="ConPty/arm64/OpenConsole.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Resource Include="RtlTerminal.ico" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <Target Name="ValidateConPtyPublishPayload" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)ConPty/x64/conpty.dll')" Text="Published ConPty payload is incomplete: ConPty/x64/conpty.dll is missing." />
    <Error Condition="!Exists('$(PublishDir)ConPty/x64/OpenConsole.exe')" Text="Published ConPty payload is incomplete: ConPty/x64/OpenConsole.exe is missing." />
    <Error Condition="!Exists('$(PublishDir)ConPty/x86/conpty.dll')" Text="Published ConPty payload is incomplete: ConPty/x86/conpty.dll is missing." />
    <Error Condition="!Exists('$(PublishDir)ConPty/x86/OpenConsole.exe')" Text="Published ConPty payload is incomplete: ConPty/x86/OpenConsole.exe is missing." />
    <Error Condition="!Exists('$(PublishDir)ConPty/arm64/conpty.dll')" Text="Published ConPty payload is incomplete: ConPty/arm64/conpty.dll is missing." />
    <Error Condition="!Exists('$(PublishDir)ConPty/arm64/OpenConsole.exe')" Text="Published ConPty payload is incomplete: ConPty/arm64/OpenConsole.exe is missing." />
    <Error Condition="!Exists('$(PublishDir)AgentEngine/Shims/xagent.cmd')" Text="Published X Agents payload is incomplete: AgentEngine/Shims/xagent.cmd is missing." />
    <Error Condition="!Exists('$(PublishDir)AgentEngine/Shims/xagent.ps1')" Text="Published X Agents payload is incomplete: AgentEngine/Shims/xagent.ps1 is missing." />
    <Error Condition="!Exists('$(PublishDir)AgentEngine/Shims/xagent')" Text="Published X Agents payload is incomplete: AgentEngine/Shims/xagent is missing." />
  </Target>



</Project>
