<Window x:Class="RtlTerminal.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rtl Terminal update"
        Icon="RtlTerminal.ico"
        Width="470"
        Height="255"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TerminalScrollBar.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource DialogForegroundBrush}" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource DialogForegroundBrush}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource DialogSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DialogForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="A new update is available"
                   FontSize="22"
                   FontWeight="SemiBold"
                   />

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,12">
            <TextBlock x:Name="VersionTextBlock"
                       FontSize="14"
                       />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{DynamicResource DialogMutedBrush}"
                       TextWrapping="Wrap"
                       Text="Open the official GitHub release page to download and install the update." />
        </StackPanel>

        <CheckBox x:Name="DontShowAgainCheckBox"
                  Grid.Row="2"
                  Margin="0,0,0,18"
                  Content="Don't show this update again" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100"
                    Margin="0,0,8,0"
                    Padding="8,6"
                    Content="Not now"
                    IsCancel="True"
                    Click="NotNowButton_Click" />
            <Button Width="145"
                    Padding="8,6"
                    Content="Open update page"
                    IsDefault="True"
                    Click="OpenUpdateButton_Click" />
        </StackPanel>
    </Grid>
</Window>
